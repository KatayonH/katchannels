---
// Only rendered on localhost (see Hero.astro). Never ships to the live site.
import { heroImages } from '../data/site';

const { current } = Astro.props as { current: string };
---

<div class="hero-switch" aria-label="Hero image options (localhost only)">
  <span>Dev only: hero image</span>
  {heroImages.map((h) => (
    <button
      type="button"
      data-src={h.src}
      data-alt={h.alt}
      data-pos={h.position}
      data-id={h.id}
      aria-pressed={String(h.id === current)}
    >
      <img src={h.src} alt="" width="64" height="40" />
      {h.label}
    </button>
  ))}
</div>

<style is:inline>
  .hero-switch {
    position: absolute;
    left: var(--gutter);
    bottom: 16px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 2 * var(--gutter));
    padding: 10px 12px;
    background: rgba(15, 32, 56, 0.85);
    border: 1px dashed rgba(197, 163, 107, 0.6);
    border-radius: 3px;
  }
  .hero-switch span { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-right: 4px; }
  .hero-switch button {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px 4px 4px;
    border-radius: 3px;
    cursor: pointer;
    color: var(--ivory);
    background: transparent;
    border: 1px solid rgba(197, 163, 107, 0.6);
  }
  .hero-switch button img { width: 48px; height: 30px; object-fit: cover; border-radius: 2px; }
  .hero-switch button[aria-pressed='true'] { color: var(--navy); background: var(--gold); border-color: var(--gold); }
</style>

<script>
  const art = document.querySelector<HTMLImageElement>('.hero-art');
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-switch button'));

  function apply(b: HTMLButtonElement) {
    if (!art) return;
    art.src = b.dataset.src!;
    art.alt = b.dataset.alt!;
    art.style.objectPosition = b.dataset.pos!;
    options.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
  }

  try {
    const saved = localStorage.getItem('kc-dev-hero');
    const match = options.find((o) => o.dataset.id === saved);
    if (match) apply(match);
  } catch { /* storage unavailable */ }

  options.forEach((b) =>
    b.addEventListener('click', () => {
      apply(b);
      try { localStorage.setItem('kc-dev-hero', b.dataset.id!); } catch { /* storage unavailable */ }
    }),
  );
</script>
