---
// After-payment pop-up.
// - Cal.com bookings: opened by the 'kc:booked' event fired from the booking panel (Book.astro).
// - Stripe Payment Link (Written Reading): Stripe redirects to https://katchannels.com/?booked=animal after payment.
import { INTAKE_FORM_URL } from '../data/site';
---
<dialog class="booked" id="booked" aria-labelledby="booked-title">
  <button type="button" class="booked-close" aria-label="Close" data-close>
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14"></path></svg>
  </button>
  <div class="booked-inner" tabindex="-1" autofocus>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#EBC27A" stroke-width="1" aria-hidden="true"><path d="M12 1v22M1 12h22"></path><path d="M12 7l1.2 3.8L17 12l-3.8 1.2L12 17l-1.2-3.8L7 12l3.8-1.2z"></path></svg>
    <h2 class="display" id="booked-title">You're <em>booked.</em></h2>
    <p>Thank you. Your confirmation and session details are on their way to your inbox.</p>

    <div data-kind="animal" hidden>
      <div class="booked-box">
        <div class="eyebrow">Next, send me three things for each animal</div>
        <ul class="three-things">
          <li>A clear photo</li>
          <li>Their name</li>
          <li>Their species</li>
        </ul>
        <p>If there's anything you'd like me to ask them, add that too. Please leave out their history and symptoms so the reading stays clear.</p>
      </div>
      <a class="kb kb-glass" href={INTAKE_FORM_URL} target="_blank" rel="noopener" style="align-self: flex-start; margin: 18px 0">Share your animal's details</a>
      <p class="small">This private link is also in your confirmation email, so you can come back to it anytime before our session.</p>
    </div>

    <div data-kind="channeling" hidden>
      <div class="booked-box">
        <div class="eyebrow">Before we meet</div>
        <p>There's nothing you need to send ahead. Just bring your questions with you to our session, and I'll bring through the answers.</p>
      </div>
      <p class="small" style="margin-top: 18px">Your video link is in your confirmation email.</p>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('booked') as HTMLDialogElement | null;

  function openBooked(kind: unknown) {
    if (!dialog || (kind !== 'animal' && kind !== 'channeling')) return;
    dialog.querySelectorAll<HTMLElement>('[data-kind]').forEach((el) => {
      el.hidden = el.dataset.kind !== kind;
    });
    if (!dialog.open) dialog.showModal();
  }

  openBooked(new URLSearchParams(location.search).get('booked'));
  window.addEventListener('kc:booked', (e) => openBooked((e as CustomEvent).detail));

  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    history.replaceState(null, '', location.pathname + location.hash);
  });
</script>
