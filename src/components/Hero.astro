---
import { design, heroImages } from '../data/site';
import HeroSwitcher from './HeroSwitcher.astro';

const dev = import.meta.env.DEV;
const hero = heroImages.find((h) => h.id === design.hero) ?? heroImages[0];
---

<section class="hero" id="top">
  <img
    class="hero-art"
    src={hero.src}
    alt={hero.alt}
    width={hero.size[0]}
    height={hero.size[1]}
    style={`object-position: ${hero.position}`}
    fetchpriority="high"
  />
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-copy">
      <div class="eyebrow">Animal communication<br />and channeling</div>
      <h1 class="display">Beyond what<br /><em>we can see.</em></h1>
      <p>I connect with animals, living or passed, and channel guidance for the people who love them.</p>
      <a class="btn-outline" href="#sessions">
        Explore sessions
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4"></path></svg>
      </a>
    </div>
  </div>
  {dev && <HeroSwitcher current={hero.id} />}
</section>
