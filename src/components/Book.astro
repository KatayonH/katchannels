---
import { sessions } from '../data/site';

const dev = import.meta.env.DEV;
const first = sessions[0];
---

<section class="book" id="book">
  <img class="bouquet bouquet-left" src="/images/bouquet-left.jpg" alt="" width="1020" height="682" loading="lazy" />
  <img class="bouquet bouquet-right" src="/images/bouquet-right.jpg" alt="" width="1020" height="682" loading="lazy" />
  <div class="wrap">
    <img class="booker-logo" src="/images/kc-mark-row.png" alt="" width="733" height="192" loading="lazy" />
    <h2 class="display">Ready <em>to connect?</em></h2>
    <p class="lede">Book your session today. Take your time gathering your photos and questions. After booking, you'll receive a private link to share everything I need before we connect.</p>

    <div class="booker">
      <div class="booker-tabs" role="tablist" aria-label="Choose a session">
        {sessions.map((s) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={String(s.id === first.id)}
            tabindex={s.id === first.id ? 0 : -1}
            data-tab={s.id}
          >
            <span class="booker-tab-name">{s.tab}</span>
            <span class="booker-tab-price">{s.price}</span>
          </button>
        ))}
      </div>

      {sessions.map((s) => (
        <div
          class="booker-panel"
          role="tabpanel"
          id={`panel-${s.id}`}
          aria-labelledby={`tab-${s.id}`}
          data-panel={s.id}
          data-kind={s.kind}
          hidden={s.id !== first.id}
        >
          {s.options && (
            <div class="animal-count">
              <span class="animal-count-label" id={`count-label-${s.id}`}>How many animals?</span>
              <div class="animal-count-pills" role="radiogroup" aria-labelledby={`count-label-${s.id}`}>
                {s.options.map((o) => {
                  const details = [o.count === 1 ? '1 animal' : `${o.count} animals`, o.length].filter(Boolean).join(' · ');
                  return (
                    <button type="button" role="radio" aria-checked={String(o.count === 1)} data-count={o.count} data-price={o.price} data-details={details}>
                      {o.count === 1 ? '1 animal' : `${o.count} animals`}
                    </button>
                  );
                })}
              </div>
              <p class="animal-count-sum" aria-live="polite"><strong>{s.options[0].price}</strong> <span>{['1 animal', s.options[0].length].filter(Boolean).join(' · ')}</span></p>
            </div>
          )}
          {(s.options ?? [{ count: 1, price: s.price, booking: s.booking }]).map((o) => (
            <div class="booker-option" data-option={o.count} hidden={o.count !== 1}>
              {o.booking.type === 'stripe' ? (
                <div class="booker-pay">
                  <img class="booker-moon" src={s.moon} alt="" width={s.moonSize[0]} height={s.moonSize[1]} loading="lazy" />
                  <h3 class="display">{s.title} <em>{s.titleItalic}</em></h3>
                  <div class="menu-meta">{o.count === 1 ? '1 animal' : `${o.count} animals`} · {s.meta}</div>
                  <p>No time slot needed. Pay securely through Stripe, then send me a photo, the name and the species {o.count === 1 ? 'of your animal' : 'of each animal'}. Your {o.count === 1 ? 'reading arrives' : 'readings arrive'} in your inbox within 7 days.</p>
                  <a class="booker-cta" href={o.booking.url}>Pay {o.price} and book</a>
                </div>
              ) : (
                <div class="cal-frame" data-cal-link={o.booking.calLink} data-cal-ns={o.count === 1 ? s.id : `${s.id}${o.count}`}>
                  <p class="cal-loading">Loading the calendar…</p>
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>

    {dev && (
      <p class="dev-note">
        Dev only: preview the after-payment pop-up with
        <a href="?booked=animal">?booked=animal</a> or <a href="?booked=channeling">?booked=channeling</a>
      </p>
    )}
  </div>
</section>

<script>
  type CalFn = ((...args: unknown[]) => void) & { ns: Record<string, (...args: unknown[]) => void>; loaded?: boolean; q?: unknown[] };
  declare global { interface Window { Cal?: CalFn } }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const started = new Set<string>();
  let bookVisible = false;

  // Cal.com's official embed loader, trimmed. Loads embed.js once and queues calls until it's ready.
  function loadCal() {
    if (window.Cal) return;
    (function (C: any, A: string, L: string) {
      const p = (a: any, ar: any) => a.q.push(ar);
      const d = C.document;
      C.Cal = C.Cal || function () {
        const cal = C.Cal;
        const ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api: any = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');
  }

  function startCalendar(panel: HTMLElement) {
    // Only the calendar for the chosen number of animals.
    const frame = panel.querySelector<HTMLElement>('[data-option]:not([hidden]) [data-cal-link]');
    if (!frame) return;
    const ns = frame.dataset.calNs!;
    if (started.has(ns)) return;
    started.add(ns);
    loadCal();
    const Cal = window.Cal!;
    Cal('init', ns, { origin: 'https://cal.com' });
    const api = Cal.ns[ns];
    frame.id = `cal-${ns}`;
    api('inline', {
      elementOrSelector: `#cal-${ns}`,
      calLink: frame.dataset.calLink,
      config: { layout: 'month_view', theme: 'light' },
    });
    api('ui', {
      theme: 'light',
      cssVarsPerTheme: { light: { 'cal-brand': '#D9A24A', 'cal-bg': '#F3EBDD', 'cal-bg-muted': '#EDE3D2', 'cal-border': '#E2D6C2', 'cal-border-subtle': '#E2D6C2' } },
      hideEventTypeDetails: false,
      layout: 'month_view',
    });
    // Keep "Loading the calendar…" showing until Cal.com says the calendar is ready.
    // If it fails, or is still not ready after 10 seconds, offer a direct link instead.
    const loading = frame.querySelector<HTMLElement>('.cal-loading');
    const showFallback = () => {
      if (!loading) return;
      loading.textContent = 'Having trouble seeing the calendar? ';
      const link = document.createElement('a');
      link.href = `https://cal.com/${frame.dataset.calLink}`;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = 'Book here instead';
      loading.append(link, '.');
    };
    const slow = window.setTimeout(showFallback, 10000);
    api('on', { action: 'linkReady', callback: () => { window.clearTimeout(slow); loading?.remove(); } });
    api('on', { action: 'linkFailed', callback: () => { window.clearTimeout(slow); showFallback(); } });
    // When a booking (and its payment) goes through, open the "You're booked" pop-up.
    api('on', {
      action: 'bookingSuccessfulV2',
      callback: () => {
        window.dispatchEvent(new CustomEvent('kc:booked', { detail: panel.dataset.kind }));
      },
    });
  }

  function select(id: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p) => {
      const on = p.dataset.panel === id;
      p.hidden = !on;
      if (on && bookVisible) startCalendar(p);
    });
  }

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      select(next.dataset.tab!, true);
    });
  });

  // "How many animals?" switches which price, payment link or calendar is shown in that panel.
  panels.forEach((panel) => {
    const choices = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-count]'));
    choices.forEach((btn, i) => {
      const choose = (b: HTMLButtonElement, focus = false) => {
        choices.forEach((c) => {
          const on = c === b;
          c.setAttribute('aria-checked', String(on));
          c.tabIndex = on ? 0 : -1;
          if (on && focus) c.focus();
        });
        panel.querySelectorAll<HTMLElement>('[data-option]').forEach((o) => { o.hidden = o.dataset.option !== b.dataset.count; });
        const sumPrice = panel.querySelector<HTMLElement>('.animal-count-sum strong');
        const sumDetails = panel.querySelector<HTMLElement>('.animal-count-sum span');
        if (sumPrice && b.dataset.price) sumPrice.textContent = b.dataset.price;
        if (sumDetails && b.dataset.details) sumDetails.textContent = b.dataset.details;
        if (bookVisible) startCalendar(panel);
      };
      btn.tabIndex = btn.getAttribute('aria-checked') === 'true' ? 0 : -1;
      btn.addEventListener('click', () => choose(btn));
      btn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        choose(choices[(i + (e.key === 'ArrowRight' ? 1 : choices.length - 1)) % choices.length], true);
      });
    });
  });

  // Session "Book" buttons elsewhere on the page jump here with their tab selected.
  document.querySelectorAll<HTMLAnchorElement>('[data-book]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      select(a.dataset.book!);
      document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // Only load Cal.com once the booking section is close to the screen, so it doesn't slow the first page load.
  const book = document.getElementById('book');
  if (book) {
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      bookVisible = true;
      const open = panels.find((p) => !p.hidden);
      if (open) startCalendar(open);
      obs.disconnect();
    }, { rootMargin: '600px 0px' }).observe(book);
  }

  // Support links like katchannels.com/#book-live
  const fromHash = location.hash.match(/^#book-(\w+)/);
  if (fromHash && tabs.some((t) => t.dataset.tab === fromHash[1])) {
    select(fromHash[1]);
    document.getElementById('book')?.scrollIntoView();
  }
</script>
