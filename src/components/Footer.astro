---
import { CONTACT_EMAIL, DISCLAIMER, social } from '../data/site';

// On the privacy page, section links need to point back to the home page.
const { home = '' } = Astro.props as { home?: string };
---

<footer class="footer">
  <div class="wrap">
    <a class="brand footer-brand" href={`${home}#top`} aria-label="Kat Channels, back to top">
      <img class="footer-logo" src="/images/kc-logo-gold.webp" alt="Kat Channels" width="900" height="184" loading="lazy" />
    </a>
    <nav class="nav-links" aria-label="Footer">
      <a href={`${home}#about`}>About</a>
      <a href={`${home}#sessions`}>Sessions</a>
      <a href={`${home}#faq`}>FAQ</a>
      <a href={`${home}#book`}>Book</a>
    </nav>
    <div class="social">
      <a href={social.instagram} aria-label="Instagram" rel="me noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.8"></circle></svg></a>
      <a href={social.tiktok} aria-label="TikTok" rel="me noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M14 3c.5 2.8 2.4 4.6 5 5"></path></svg></a>
      <a href={`mailto:${CONTACT_EMAIL}`} aria-label={`Email ${CONTACT_EMAIL}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="M3 6l9 7 9-7"></path></svg></a>
    </div>
  </div>
  <div class="wrap footer-fine">
    <p>{DISCLAIMER}</p>
    <p>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <span aria-hidden="true">·</span>
      <a href="/privacy">Privacy</a>
      <span aria-hidden="true">·</span>
      <span>© {new Date().getFullYear()} Kat Channels</span>
    </p>
  </div>
</footer>
