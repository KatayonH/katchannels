---
import { faqGroups, CONTACT_EMAIL } from '../data/site';
---

<section class="faq" id="faq">
  <div class="wrap faq-layout">
    <div class="faq-intro">
      <div class="eyebrow">04 / FAQ</div>
      <h2 class="display">Good <em>to know.</em></h2>
      <p class="lede">Still wondering about something? Email me at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and I'll get back to you.</p>
    </div>
    <div class="faq-groups">
      {faqGroups.map((g, gi) => (
        <div class="faq-group">
          <h3 class="faq-group-title">{g.title}</h3>
          <div class="faq-list">
            {g.items.map((f, i) => (
              <details class="faq-item" name="faq" open={gi === 0 && i === 0}>
                <summary>
                  <span class="faq-q">{f.q}</span>
                  <span class="faq-mark" aria-hidden="true"></span>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
