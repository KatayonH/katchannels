---
import { faqGroups, CONTACT_EMAIL } from '../data/site';
---

<section class="faq" id="faq">
  <div class="wrap faq-wrap">
    <div class="faq-intro">
      <div class="eyebrow">04 / FAQ</div>
      <h2 class="display">Good <em>to know.</em></h2>
    </div>

    <div class="faq-layout">
      <div class="faq-topics" role="tablist" aria-label="Question topics">
        {faqGroups.map((g, gi) => (
          <button
            type="button"
            role="tab"
            class="faq-topic"
            id={`faq-tab-${gi}`}
            aria-controls={`faq-panel-${gi}`}
            aria-selected={String(gi === 0)}
            tabindex={gi === 0 ? 0 : -1}
          >
            <span>{g.title}</span>
            <svg class="faq-topic-chev" width="9" height="15" viewBox="0 0 9 15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M1 1l6.5 6.5L1 14"></path></svg>
          </button>
        ))}
        <button type="button" role="tab" class="faq-topic" id="faq-tab-contact" aria-controls="faq-panel-contact" aria-selected="false" tabindex="-1">
          <span>More questions</span>
          <svg class="faq-topic-chev" width="9" height="15" viewBox="0 0 9 15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M1 1l6.5 6.5L1 14"></path></svg>
        </button>
      </div>

      <div class="faq-panels">
        {faqGroups.map((g, gi) => (
          <div class="faq-panel" role="tabpanel" id={`faq-panel-${gi}`} aria-labelledby={`faq-tab-${gi}`} hidden={gi !== 0}>
            <h3 class="faq-panel-title">{g.title}</h3>
            <div class="faq-list">
              {g.items.map((f, i) => (
                <details class="faq-item" name={`faq-${gi}`} open={i === 0}>
                  <summary>
                    <span class="faq-q">{f.q}</span>
                    <svg class="faq-chev" width="15" height="9" viewBox="0 0 15 9" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M1 1l6.5 6.5L14 1"></path></svg>
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
            <p class="faq-more">Still have a question? <button type="button" class="faq-more-link" data-open-contact>Send me a message</button></p>
          </div>
        ))}
        <div class="faq-panel faq-contact" role="tabpanel" id="faq-panel-contact" aria-labelledby="faq-tab-contact" hidden>
          <h3 class="faq-panel-title faq-contact-title">Still have a question?</h3>
          <p class="faq-contact-text">Send me a message and I'll get back to you.</p>
          <!-- Messages are sent by Web3Forms straight to Kat's inbox. The access key only says where to deliver; it is not a secret. -->
          <form class="contact-form" name="contact" method="POST" action="https://api.web3forms.com/submit">
            <input type="hidden" name="access_key" value="d5a979a2-539f-4b1a-aac5-2d1408dd0328" />
            <input type="hidden" name="subject" value="New message from katchannels.com" />
            <input type="hidden" name="from_name" value="Kat Channels website" />
            <p class="contact-trap" aria-hidden="true"><label>Leave this empty <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></p>
            <div class="contact-row">
              <label class="contact-field">
                <span>Name</span>
                <input type="text" name="name" autocomplete="name" required />
              </label>
              <label class="contact-field">
                <span>Email</span>
                <input type="email" name="email" autocomplete="email" required />
              </label>
            </div>
            <label class="contact-field">
              <span>Message</span>
              <textarea name="message" rows="5" required></textarea>
            </label>
            <button class="faq-contact-btn" type="submit">Send message</button>
            <p class="contact-status" role="status" aria-live="polite"></p>
          </form>
          <p class="contact-alt">Or email me at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Contact form: send the message without leaving the page, then say thank you.
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('.contact-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      const result = await res.json().catch(() => ({}));
      if (!res.ok || !result.success) throw new Error(result.message || String(res.status));
      form.reset();
      form.classList.add('is-sent');
      status.textContent = "Thank you. Your message is on its way, and I'll get back to you soon.";
    } catch {
      status.textContent = "Sorry, that didn't send. Please email me at hello@katchannels.com instead.";
    } finally {
      button.disabled = false;
    }
  });
</script>

<script>
  // Topic menu: click or use the arrow keys to switch which group of questions shows.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-topic'));
  const show = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !on;
    });
    if (focus) tab.focus();
  };
  // "Send me a message" at the end of each topic opens the More questions tab.
  const contactTab = document.getElementById('faq-tab-contact') as HTMLButtonElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-open-contact]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!contactTab) return;
      show(contactTab);
      document.getElementById('faq-panel-contact')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      document.querySelector<HTMLInputElement>('.contact-form [name="name"]')?.focus({ preventScroll: true });
    }),
  );
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t));
    t.addEventListener('keydown', (e) => {
      const next = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (!next) return;
      e.preventDefault();
      show(tabs[(i + next + tabs.length) % tabs.length], true);
    });
  });
</script>
