---
// Only rendered on localhost (see Sessions.astro). Never ships to the live site.
import { design, buttonStyles } from '../data/site';
---

<div class="dev-switch" aria-label="Button style options (localhost only)">
  <div class="dev-row">
    <span>Dev only: button style</span>
    {buttonStyles.map((b) => (
      <button type="button" data-value={b.cls} aria-pressed={String(b.cls === design.button)}>{b.label}</button>
    ))}
  </div>
</div>

<style is:inline>
  .dev-switch {
    align-self: flex-start;
    padding: 10px 12px;
    background: rgba(15, 32, 56, 0.7);
    border: 1px dashed rgba(197, 163, 107, 0.6);
    border-radius: 3px;
  }
  .dev-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .dev-row span { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-right: 4px; }
  .dev-switch button {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 7px 11px;
    border-radius: 3px;
    cursor: pointer;
    color: var(--ivory);
    background: transparent;
    border: 1px solid var(--gold);
  }
  .dev-switch button[aria-pressed='true'] { color: var(--navy); background: var(--gold); }
</style>

<script>
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.dev-switch button'));
  const classes = options.map((b) => b.dataset.value!);

  function apply(cls: string) {
    document.querySelectorAll('[data-kb]').forEach((a) => {
      a.classList.remove(...classes);
      a.classList.add(cls);
    });
    options.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === cls)));
  }

  try {
    const saved = localStorage.getItem('kc-dev-button');
    if (saved && classes.includes(saved)) apply(saved);
  } catch { /* storage unavailable */ }

  options.forEach((b) =>
    b.addEventListener('click', () => {
      apply(b.dataset.value!);
      try { localStorage.setItem('kc-dev-button', b.dataset.value!); } catch { /* storage unavailable */ }
    }),
  );
</script>
