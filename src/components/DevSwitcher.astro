---
// Only rendered on localhost (see Sessions.astro). Never ships to the live site.
import { design, buttonStyles, cardStyles } from '../data/site';

const layouts = [
  { label: 'Menu list', value: 'menu' },
  { label: 'Cards', value: 'cards' },
];
---

<div class="dev-switch" aria-label="Design options (localhost only)">
  <div class="dev-row">
    <span>Dev only: layout</span>
    {layouts.map((l) => (
      <button type="button" data-set="layout" data-value={l.value} aria-pressed={String(l.value === design.layout)}>{l.label}</button>
    ))}
  </div>
  <div class="dev-row">
    <span>Card style</span>
    {cardStyles.map((c) => (
      <button type="button" data-set="card" data-value={c.value} aria-pressed={String(c.value === design.card)}>{c.label}</button>
    ))}
  </div>
  <div class="dev-row">
    <span>Button style</span>
    {buttonStyles.map((b) => (
      <button type="button" data-set="button" data-value={b.cls} aria-pressed={String(b.cls === design.button)}>{b.label}</button>
    ))}
  </div>
</div>

<style>
  .dev-switch {
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(15, 32, 56, 0.7);
    border: 1px dashed rgba(197, 163, 107, 0.6);
    border-radius: 3px;
  }
  .dev-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .dev-row span { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-right: 4px; }
  button {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 7px 11px;
    border-radius: 3px;
    cursor: pointer;
    color: var(--ivory);
    background: transparent;
    border: 1px solid var(--gold);
  }
  button[aria-pressed='true'] { color: var(--navy); background: var(--gold); }
</style>

<script>
  const section = document.getElementById('sessions');
  const kbClasses = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-set="button"]')).map((b) => b.dataset.value!);
  const saved = (() => {
    try { return JSON.parse(localStorage.getItem('kc-dev-design') || '{}'); } catch { return {}; }
  })();

  function apply(key: string, value: string) {
    if (!section) return;
    if (key === 'layout') section.dataset.layout = value;
    if (key === 'card') section.dataset.card = value;
    if (key === 'button') {
      section.querySelectorAll('[data-kb]').forEach((a) => {
        a.classList.remove(...kbClasses);
        a.classList.add(value);
      });
    }
    document.querySelectorAll<HTMLButtonElement>(`[data-set="${key}"]`).forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.value === value));
    });
  }

  for (const [k, v] of Object.entries(saved)) apply(k, v as string);

  document.querySelectorAll<HTMLButtonElement>('.dev-switch button').forEach((b) => {
    b.addEventListener('click', () => {
      const key = b.dataset.set!;
      const value = b.dataset.value!;
      apply(key, value);
      saved[key] = value;
      try { localStorage.setItem('kc-dev-design', JSON.stringify(saved)); } catch { /* storage unavailable */ }
    });
  });
</script>
