---
// On other pages (like /privacy), section links need to point back to the home page.
const { home = '' } = Astro.props as { home?: string };
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href={`${home}#top`} aria-label="Kat Channels, home">
      <img class="brand-logo" src="/images/kc-logo-horizontal.png" alt="Kat Channels" width="291" height="120" />
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      <a href={`${home}#about`}>About</a>
      <a href={`${home}#sessions`}>Sessions</a>
      <a href={`${home}#process`}>The Process</a>
      <a href={`${home}#faq`}>FAQ</a>
    </nav>
    <div class="nav-actions">
      <a class="btn-outline nav-book" href={`${home}#book`}>Book<span class="nav-book-long"> a session</span></a>
      <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" aria-label="Menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.getElementById('nav-links');
  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    links?.classList.toggle('is-open', open);
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
