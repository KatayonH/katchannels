---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kat Channels | Animal Communication and Channeling',
  description = 'Animal communication readings and channeling sessions with Kat. Written or live readings, online, for you and the animals you love.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://katchannels.com/" />
    <meta property="og:image" content="https://katchannels.com/images/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kat Channels logo: a gold crescent moon, K and C, and a full moon on navy" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0F2038" />
    <link rel="icon" type="image/png" href="/images/kc-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
    />
    <!-- Visitor counts (GoatCounter: no cookies, no personal data) -->
    <script is:inline data-goatcounter="https://katchannels.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
